(_flow fab_demo "2022.2-SP6.4"
    (_comment "Industrial monitoring system")
    (_version "1.1.0")
    (_status "initial")
    (_project
        (_option prj_work_dir
            (_string ".")
        )
        (_option prj_impl_dir
            (_string ".")
        )
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input
                (_part
                    (_family Logos)
                    (_device PGL50H)
                    (_speedgrade -6)
                    (_package FBG484)
                )
            )
        )
        (_widget wgt_my_design_src
            (_input
                (_file "source/alu.v"
                    (_format verilog)
                )
                (_file "source/bht.v"
                    (_format verilog)
                )
                (_file "source/btb.v"
                    (_format verilog)
                )
                (_file "source/core.v"
                    (_format verilog)
                )
                (_file "source/csr_file.v"
                    (_format verilog)
                )
                (_file "source/cyclectr.v"
                    (_format verilog)
                )
                (_file "source/decoder.v"
                    (_format verilog)
                )
                (_file "source/dmem.v"
                    (_format verilog)
                )
                (_file "source/gpio.v"
                    (_format verilog)
                )
                (_file "source/imem.v"
                    (_format verilog)
                )
                (_file "source/mes50hp_app80_top.v"
                    (_format verilog)
                )
                (_file "source/mes50hp_pll80.v"
                    (_format verilog)
                )
                (_file "source/mtimer.v"
                    (_format verilog)
                )
                (_file "source/muldiv.v"
                    (_format verilog)
                )
                (_file "source/ras.v"
                    (_format verilog)
                )
                (_file "source/regfile.v"
                    (_format verilog)
                )
                (_file "source/soc_top.v"
                    (_format verilog)
                )
                (_file "source/uart.v"
                    (_format verilog)
                )
                (_file "source/uart_mon.v"
                    (_format verilog)
                )
            )
        )
        (_widget wgt_my_ips_src)
        (_widget wgt_import_logic_con_file
            (_input
                (_file "constraints/board.fdc"
                    (_format fdc)
                )
            )
        )
        (_widget wgt_edit_user_cons
            (_attribute _click_to_run
                (_switch ON)
            )
        )
        (_widget wgt_simulation)
    )
    (_task tsk_compile
        (_command cmd_compile
            (_gci_state
                (_integer 0)
            )
            (_option top_module
                (_string "mes50hp_app80_top")
            )
        )
        (_widget wgt_rtl_view
            (_attribute _click_to_run
                (_switch ON)
            )
        )
    )
    (_task tsk_synthesis
        (_command cmd_synthesize
            (_gci_state
                (_integer 0)
            )
            (_option selected_syn_tool_opt
                (_integer 2)
            )
        )
        (_widget wgt_tech_view
            (_attribute _click_to_run
                (_switch ON)
            )
        )
        (_widget wgt_map_constraint)
        (_widget wgt_my_fic_src)
        (_widget wgt_inserter_gui_view
            (_attribute _click_to_run
                (_switch ON)
            )
        )
    )
    (_task tsk_devmap
        (_command cmd_devmap
            (_gci_state
                (_integer 0)
            )
        )
        (_widget wgt_edit_route_cons
            (_attribute _click_to_run
                (_switch ON)
            )
        )
    )
    (_task tsk_pnr
        (_command cmd_pnr
            (_gci_state
                (_integer 0)
            )
            (_option action_timeout
                (_integer 30)
            )
            (_option gplace_seed
                (_integer 8)
            )
            (_option gplace_times
                (_integer 3)
            )
            (_option saved_outcome
                (_integer 3)
            )
            (_option parallel
                (_integer 3)
            )
            (_option mode
                (_string "performance")
            )
            (_option optimize_multi_corner_timing
                (_switch ON)
            )
            (_option fix_hold_violation
                (_switch ON)
            )
            (_option refineplacement_mode
                (_string "Swap")
            )
        )
        (_widget wgt_power_calculator
            (_attribute _click_to_run
                (_switch ON)
            )
        )
        (_widget wgt_timing_analysis
            (_attribute _click_to_run
                (_switch ON)
            )
        )
        (_command cmd_report_post_pnr_timing
            (_gci_state
                (_integer 0)
            )
            (_attribute _auto_exe_lock
                (_switch OFF)
            )
            (_option max_path
                (_integer 50)
            )
        )
        (_widget wgt_arch_browser
            (_attribute _click_to_run
                (_switch ON)
            )
        )
        (_command cmd_report_power
            (_gci_state
                (_integer 0)
            )
            (_attribute _auto_exe_lock
                (_switch OFF)
            )
            (_attribute _auto_exe
                (_switch OFF)
            )
        )
        (_command cmd_gen_netlist
            (_gci_state
                (_integer 0)
            )
            (_attribute _auto_exe_lock
                (_switch OFF)
            )
            (_attribute _auto_exe
                (_switch OFF)
            )
        )
    )
    (_task tsk_gen_bitstream
        (_command cmd_gen_bitstream
            (_gci_state
                (_integer 0)
            )
        )
    )
)
