// Mini CPU 测试程序
//
// 指令格式：
// [15:12] opcode
// [11:0]  operand
//
// 0xxx = NOP
// 1xxx = LDI
// 2xxx = ADDI
// 3xxx = SUBI
// 4xxx = OUT
// 5xxx = JMP
// Fxxx = HALT

1005    // LDI  5
2003    // ADDI 3
2004    // ADDI 4
3002    // SUBI 2
4000    // OUT -> 10
0000    // NOP
2005    // ADDI 5
3001    // SUBI 1
4000    // OUT -> 14
F000    // HALT