# MES50HP hardware manual tables 2-3, 3-5, 3-8, 3-9.
# Physical 50 MHz oscillator and actual PLL-generated 80 MHz CPU clock.
create_clock -name clk50 -period 20.000 -waveform {0.000 10.000} [get_ports {clk50}]
create_generated_clock -name cpu_clk -source [get_ports {clk50}] -multiply_by 8 -divide_by 5 [get_pins {clock_i/pll_i/CLKOUT0}]
# Add 0.05 ns board margin to the PDS default uncertainty.
set_clock_uncertainty -setup 0.050 [get_clocks {clk50 cpu_clk}]
set_clock_uncertainty -hold 0.050 [get_clocks {clk50 cpu_clk}]
# UART RX is asynchronous and has an existing two-flop synchronizer.
# KEY1 only asynchronously asserts the two reset synchronizer flops above.
# These interface exceptions do not cut any register-to-register CPU paths.
set_input_delay -clock clk50 -max 0.000 [get_ports {key1_n uart_rxd mon_rxd}]
set_input_delay -clock clk50 -min 0.000 [get_ports {key1_n uart_rxd mon_rxd}]
set_false_path -from [get_ports {key1_n uart_rxd mon_rxd}]
# UART TX and LEDs have no synchronous receiving clock on this board.
# Bound their data propagation to 20 ns without inventing a capture clock/hold spec.
set_max_delay -datapath_only -to [get_ports {uart_txd led[*]}] 20.000
define_attribute {p:clk50} {PAP_IO_LOC} {P20}
define_attribute {p:clk50} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk50} {PAP_IO_VCCIO} {3.3}
define_attribute {p:key1_n} {PAP_IO_LOC} {K18}
define_attribute {p:key1_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:key1_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_rxd} {PAP_IO_LOC} {R8}
define_attribute {p:uart_rxd} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_rxd} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_txd} {PAP_IO_LOC} {R9}
define_attribute {p:uart_txd} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_txd} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_txd} {PAP_IO_DRIVE} {4}
define_attribute {p:uart_txd} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[0]} {PAP_IO_LOC} {B2}
define_attribute {p:led[0]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[0]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[0]} {PAP_IO_DRIVE} {4}
define_attribute {p:led[0]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[1]} {PAP_IO_LOC} {A2}
define_attribute {p:led[1]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[1]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[1]} {PAP_IO_DRIVE} {4}
define_attribute {p:led[1]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[2]} {PAP_IO_LOC} {B3}
define_attribute {p:led[2]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[2]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[2]} {PAP_IO_DRIVE} {4}
define_attribute {p:led[2]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[3]} {PAP_IO_LOC} {A3}
define_attribute {p:led[3]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[3]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[3]} {PAP_IO_DRIVE} {4}
define_attribute {p:led[3]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[4]} {PAP_IO_LOC} {C5}
define_attribute {p:led[4]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[4]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[4]} {PAP_IO_DRIVE} {4}
define_attribute {p:led[4]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[5]} {PAP_IO_LOC} {A5}
define_attribute {p:led[5]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[5]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[5]} {PAP_IO_DRIVE} {4}
define_attribute {p:led[5]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[6]} {PAP_IO_LOC} {F7}
define_attribute {p:led[6]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[6]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[6]} {PAP_IO_DRIVE} {4}
define_attribute {p:led[6]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[7]} {PAP_IO_LOC} {F8}
define_attribute {p:led[7]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[7]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[7]} {PAP_IO_DRIVE} {4}
define_attribute {p:led[7]} {PAP_IO_SLEW} {SLOW}

# MES50HP manual table 3-12: J8 pin3, EX_IO_11N, AB13, 3.3 V.
define_attribute {p:mon_rxd} {PAP_IO_LOC} {AB13}
define_attribute {p:mon_rxd} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:mon_rxd} {PAP_IO_VCCIO} {3.3}
