// Sail 0.15 参考模型配置：pango-rv32i（本仓库五级流水线核心，RV32IM_Zicsr）
// 衍生自 Sail 官方 PicoRV32 示例配置（picorv32_axi, RV32IMC），保留原版权：
// Copyright (c) 2026, Harvey Mudd College
// SPDX-License-Identifier: Apache-2.0
// 已按本核心实际架构修正扩展声明（M / Zmmul / Zicsr 已支持，Zca 不支持）并实现
// M 态异常/中断（mtvec direct/vectored、MTI/MSI/MEI、WFI 睡眠唤醒）。
//
// 与本核心仍有意保留的差异（当前测试不触及）：
// dtb_address=0x1000 与 CLINT/IO 区布局是 Sail 平台与 ACT 框架的要求，
// 与本 SoC 外设映射（0x1000_0000 起）无关；框架不传 DTB，该地址不会被写，
// 仅 Sail 启动时把 a1 初始化为该值（随机测试已在生成侧初始化全部寄存器）。
// 正文中其余 "PicoRV32" 注释为衍生来源的说明文字。
{
  "$schema": "https://github.com/riscv/sail-riscv/releases/download/0.15/sail_riscv_config_schema.json",
  "base": {
    "xlen": 32,
    "E": false,
    // Whether a `mhpmcounter` increments if the event it is counting
    // was generated during a write to its corresponding `mhpmevent`
    // CSR (which could change the monitored event).
    "hpmcounter_increments_in_self_hpmevent_write": false,
    // The precision of the HPM counter, upto 64 bits.
    // PicoRV32 has no HPM counters (writable_hpm_counters is 0), so this and
    // hpmevent_width_bits have no effect.
    "hpmcounter_width_bits": 64,
    // The width of the `mhpmevent` CSRs, upto 64 bits, if Sscofpmf is
    // not supported.  On RV32 without Sscofpmf, this can be upto 32,
    // since the `mhpmeventh` CSRs are not accessible.
    // If Sscofpmf is supported, the `mhpmevent` CSRs are always 64
    // bits; this value then defines the number, upto 56, of the lowest
    // bits of the CSRs that are used as the event selector.
    "hpmevent_width_bits": 32,
    // PicoRV32 has no CSRs, so no mcountinhibit.  Must agree with
    // MCOUNTINHIBIT_IMPLEMENTED in picorv32-rv32imc.yaml.
    "mcountinhibit": {
      // Whether the `mcountinhibit` CSR is implemented.
      "supported": false,
      // This bits in this value control whether the corresponding
      // bits of the CSR are writable.  Note that bit 1 cannot be written
      // to as it is read-only zero.
      "writable_bits": { "len": 32, "value": "0x0" }
    },
    "writable_fiom": true,
    // PicoRV32 has no CSR instructions, so no hpmcounter is reachable.
    "writable_hpm_counters": {
      "len": 32,
      "value": "0x0"
    },
    // PicoRV32 has no S-mode and no CSRs, so all bits are read-only zero.
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    // The bits in this value control whether the corresponding bits
    // of the `mcounteren` CSR that control access to HPM counters,
    // and `cycle`, `time` and `instret` registers at lower privilege
    // modes, are read-only zero. A set bit specifies that the
    // corresponding bit of `mcounteren` is writable, otherwise the
    // bit is read-only zero.
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    "hcounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    // `mtvec.{direct,vectored}.supported` indicates whether the
    // corresponding mode is supported for `mtvec`.  At least one mode
    // should be supported.  If both modes are supported, the mode on
    // reset is unspecified.
    // The `mtvec.{direct,vectored}.base_alignment` parameters control the alignment
    // of the trap vector base for each mode.  The alignment is
    // specified as the power of 2 of the desired byte alignment, and
    // can range from a minimum of 2 upto a maximum of 24. If
    // unaligned values are written to these CSRs, the lowest bits
    // will be zeroed to respect the specified alignment.
    // mtvec direct/vectored 均已实现（本核心支持两种模式）。
    "mtvec": {
      "direct": {
        "supported": true,
        "base_alignment": 2
      },
      "vectored": {
        "supported": true,
        "base_alignment": 2
      }
    },
    // Similar to `mtvec` above. If `S` mode is not supported, these
    // values need to be present and legal but are ignored.
    "stvec": {
      // The spec requires `base_alignment` for `stvec.direct` to be 2
      // (i.e. 4-byte alignment), hence there is no configuration
      // parameter for it.
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    "vstvec": {
      "direct": {
        "supported": false
      },
      "vectored": {
        "supported": false,
        "base_alignment": 2
      }
    },
    // No S-mode, so nothing is delegatable.
    "medeleg": {
      "delegatable_bits": {
        "len": 64,
        "value": "0x0"
      }
    },
    "mideleg": {
      "delegatable_bits": {
        "len": "xlen",
        "value": "0x0"
      }
    },
    // These settings control whether the specified exceptions
    // cause information to be written into the appropriate
    // `xtval` registers.
    "xtval_nonzero": {
      // 本核心 mtval 行为：非法指令记录指令编码，非对齐/总线错误记录访存地址
      "illegal_instruction": true,
      "virtual_instruction": false,
      "load_guest_page_fault": false,
      "samo_guest_page_fault": false,
      "fetch_guest_page_fault": false,
      "software_breakpoint": false,
      "hardware_breakpoint": false,
      "load_address_misaligned": true,
      "load_access_fault": true,
      "load_page_fault": false,
      "samo_address_misaligned": true,
      "samo_access_fault": true,
      "samo_page_fault": false,
      "fetch_address_misaligned": false,
      "fetch_access_fault": false,
      "fetch_page_fault": false,
      "software_check": false,
      "hardware_error": false,
      "reserved_exceptions": false
    },
    "reserved_behavior": {
      // The configuration option determines how to handle the reserved behavior `amocas_odd_registers`.
      // "AMOCAS_Fatal"  – raise a Sail exception, stopping execution.
      // "AMOCAS_Illegal" – treat it as an illegal instruction.
      "amocas_odd_register": "AMOCAS_Illegal",
      // The configuration option determines how to handle execution of a floating-point
      // instruction with DYN (dynamic) rounding mode when `fcsr.FRM` contains a
      // reserved value (0b101, 0b110, 0b111).
      // This does not affect the execution of floating-point instructions that have a
      // reserved rounding mode statically encoded in the instruction.
      // "Fcsr_RM_Fatal"  – raise a Sail exception, stopping execution.
      // "Fcsr_RM_Illegal" – treat it as an illegal instruction.
      "fcsr_rm": "Fcsr_RM_Illegal",
      // The configuration option determines how to handle the reserved behavior `pmpcfg_with_R0W1`.
      // "PMP_Fatal"  – raise a Sail exception, stopping execution.
      // "PMP_ClearPermissions" – convert a PMP entry with R=0, W=1 to R=0, W=0, X=0.
      "pmpcfg_write_only": "PMP_ClearPermissions",
      // The configuration option determines how to handle the reserved behavior `xenvcfg.CBIE` with 0b10.
      // "Xenvcfg_Fatal"  – raise a Sail exception, stopping execution.
      // "Xenvcfg_ClearPermissions" – convert CBIE with 0b10 to 0b00.
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      // The configuration option determines how to handle the reserved behavior `xtvec[Mode] >= 2`.
      // "Xtvec_Fatal"  – raise a Sail exception, stopping execution.
      // "Xtvec_Ignore" – use old Mode of xtvec.
      "xtvec_mode": "Xtvec_Ignore",
      // The configuration option determines how to handle the reserved behavior: Odd-numbered registers for RV32Zdinx.
      // "Zdinx_Fatal"  – raise a Sail exception, stopping execution.
      // "Zdinx_Illegal" – treat it as an illegal instruction.
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "mstatus": {
      // The legal values for the FS and VS fields in this CSR are
      // specified by the two fields below.  Their values can be one
      // of:
      // - "ExtContext_FourState" allows all values {Off, Initial, Clean, Dirty}.
      // - "ExtContext_TwoState" allows {Off, Dirty}, and writes of Initial and Clean get written as Dirty.
      // - "ExtContext_Off" allows only {Off}.  This makes the field read-only zero.
      "fs_legal_states": "ExtContext_Off",
      "vs_legal_states": "ExtContext_Off"
    },
    "privileged_isa_version": "Privileged_ISA_1_11"
  },
  "memory": {
    "physaddr_bits": 32,
    "asidlen": 9,
    "vmidlen": 7,
    "pmp": {
      "grain": 0,
      // This specifies the number of PMP entries present.
      // The value must be one of 0, 16, or 64.
      "count": 0,
      // This specifies the number of usable PMP entries.
      // Entries higher than this are read-only-zero.
      // The value must be less than or equal to `count`.
      "usable_count": 0,
      "tor_supported": true,
      "na4_supported": true,
      "napot_supported": true
    },
    // These settings control global support for misaligned access so they are
    // checked before address translation. `misaligned_exceptions` in
    // `regions` is checked after address translation.
    "misaligned": {
      // 本核心非对齐 load/store 产生非对齐异常（陷入 mtvec），与 Sail 一致；
      // UDB 声明 MISALIGNED_LDST=false，测试不产生非对齐访问。
      "exceptions": {
        "load_store": { "Some": "AlignmentException" },
        "vector": { "None": null },
        "lrsc": { "Some": "AccessFault" },
        "amo": { "Some": "AccessFault" }
      },
      "default_allowed_within_exp": 0,
      "byte_by_byte": false,
      "order_decreasing": false
    },
    // Address to write DTB to (if provided). 框架不传 DTB；仅启动时 a1 被置为该值。
    "dtb_address": {
      "len": 64,
      "value": "0x1000"
    },
    "regions": [
      // Main memory: code and data. Tests link from 0, the reset address (see link.ld).
      // 8 MiB 大于 tb_soc 仿真 RAM（1 MiB）：差异方向为"错必现"（RTL 越界即停机，
      // 签名必然不一致），且 ACT/随机测试映像均有 1 MiB 内 ASSERT，不受影响。
      {
        "base": {
          "len": 64,
          "value": "0x0"
        },
        "size": {
          "len": 64,
          "value": "0x800000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          // 同上：非对齐访问配为 alignment exception（不被触发，见上方说明）。
          "misaligned_exceptions": {
            "load_store": { "Some": "AlignmentException" },
            "vector": { "None": null },
            "amo": "AccessFault",
            "lrsc": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": true
      },
      // IO memory. PicoRV32's testbench has no CLINT and no interrupt generator,
      // but ACT's signature pipeline requires both Sail devices to be enabled
      // (framework/src/act/build_plan.py:_sail_platform_base), so they are declared
      // here at the same addresses cv32e20 uses. No selected test touches them.
      // The picorv32 testbench's own console (0x1000_0000) and pass register
      // (0x2000_0000) are deliberately NOT described here: tests/env/sail_macros.h
      // #undefs RVMODEL_IO_WRITE_STR and RVMODEL_HALT_PASS for the signature ELF and
      // substitutes HTIF, so Sail never issues those stores.
      {
        "base": {
          "len": 64,
          "value": "0x2000000"
        },
        "size": {
          "len": 64,
          "value": "0xE000000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault",
            "lrsc": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      }
    ]
  },
  "platform": {
    // PicoRV32 has no mvendorid/marchid/mimpid CSRs; all read as 0 by definition.
    "vendorid": 0,
    "archid": 0,
    "impid": 0,
    "hartid": 0,
    // Cache block size, specified as a power of 2.
    "cache_block_size_exp": 6,
    "reservation": {
      // Reservation set size/alignment as a power of 2. Minimum 2 on RV32.
      "reservation_set_size_exp": 3,
      // PicoRV32 has no A extension so LR/SC is never executed.
      "require_exact_reservation_addr": false,
      // Some implementations (e.g. SiFive U74) also invalidate the
      // reservation on stores from the same hart.  If this is set to `true`, the
      // model invalidates the reservation if a store from the same hart lies within
      // the reservation set.
      "invalidate_on_same_hart_store": false
    },
    // 本核心已实现 MTI/MSI/MEI（mtimer 定时器、软件置 MSIP、UART/GPIO 外部线）
    "interrupts": {
      "machine": {
        "software": { "supported": true },
        "external": { "supported": true },
        "timer": { "supported": true }
      }
    },
    "clint": {
      "supported": true,
      // This must be in a suitable memory region (see `memory.regions`).
      "base": 33554432,
      "size": 786432
    },
    // Simple MMIO device to generate interrupts for testing purposes.
    "simple_interrupt_generator": {
      "supported": true,
      // Must be 4-byte aligned and within a memory region. Size is always 0x20.
      "base": 201326592
    },
    "clock_frequency": 1000000000,
    "instructions_per_tick": 2,
    "wfi_is_nop": false,
    // WFI is optionally available to User mode.  Note that even if
    // `wfi_is_nop` is set to `true` above, it will still not be
    // available to User mode unless `wfi_available_to_user_mode` is
    // also `true`.
    "wfi_available_to_user_mode": true,
    "max_time_to_wait": 1000,
    // The model can generate the following events that can be tracked
    // using the HPM counters:
    // - EV_FENCE
    // - EV_MISALIGNED_LOAD_EXCEPTION
    // - EV_MISALIGNED_STORE_EXCEPTION
    // - EV_TLB_MISS
    //
    // An event can be mapped to a selector value, that when written
    // to the event field of an `mhpmeventNN` CSR, will increment the
    // corresponding `mhpmcounterNN` CSR as per the specification
    // (e.g. the `Sscofpmf` extension).
    //
    // The selector values need to fit into the event field of an
    // `mhpmeventNN` CSR. When Sscofpmf is not supported, this field
    // is `base.hpmevent_width_bits` wide; with Sscofpmf, this field
    // is the lowest 56 bits of the 64-bit `mhpeventNN` CSR.
    //
    // The `event_selectors` list can contain any subset of these
    // supported events.  Events cannot be repeated in the list, and
    // the selector values should be unique.  These selector values
    // are always specified as 64-bit, but their values must fit the
    // width restrictions mentioned above.
    "event_selectors": []
  },
  "extensions": {
    "M": {
      "mutable_misa": false,
      "supported": true    // RV32M 乘除法单元已实现（rtl/muldiv.sv）
    },
    "A": {
      "mutable_misa": false,
      "supported": false
    },
    "F": {
      "mutable_misa": false,
      "supported": false,
      "fflags_dirty_policy": "Fflags_Dirty_Precise"
    },
    "D": {
      "mutable_misa": false,
      "supported": false
    },
    "C": {
      "mutable_misa": false
    },
    "V": {
      "mutable_misa": false,
      // `support_level` must be one of the below strings:
      // . "Disabled" for no vector extension support
      // . "Integer" for Zve*x support
      // . "Float_single" for Zve*f support
      // . "Float_double" for Zve*d support
      // . "Full" for the full V extension
      // Note that `support_level` requires compatible
      // values for `vlen_exp` and `elen_exp` below.
      // For e.g. Zve32x and Zve32f require `elen_exp` >= 5,
      // Zve64x, Zve64f, and Zve64d require `elen_exp` >= 6,
      // and V requires `elen_exp` >= 6 and `vlen_exp` >= 7.
      "support_level": "Disabled",
      "vlen_exp": 7,
      "elen_exp": 6,
      "reserved_behavior": {
        // This determines how to handle attempts by vsetvli, vsetivli,
        // and vsetvl to set an unsupported or reserved vtype.
        // "IllegalVtype_SetVill" - set vtype.vill, set vl to zero, clear vstart, and write rd.
        // "IllegalVtype_Illegal" - treat it as an illegal instruction.
        // "IllegalVtype_Fatal"   - raise a Sail exception, stopping execution.
        "illegal_vtype": "IllegalVtype_SetVill",
        // This determines how to handle an out-of-bounds vstart (vstart >= VLMAX), which the
        // vector spec marks reserved and recommends, but does not require, trapping.
        // "Vstart_Illegal" - raise an illegal instruction exception.
        // "Vstart_Ignore"  - treat as a no-op, the instruction writes nothing.
        "vstart_out_of_bounds": "Vstart_Illegal"
      },
      "vl_use_ceil": false,
      // The maximum index EEW for indexed vector addressing mode, as
      // a power of 2.  This must be at least 3 but must not exceed
      // the supported ELEN.
      "max_index_eew_exp": 5,
      "vstart": {
        // The vector specification permits implementations to raise an
        // illegal instruction exception when `vstart` is non-zero for
        // instructions that cannot produce such a `vstart` value through
        // normal execution.
        "zero_required": {
          // Whether vector arithmetic instructions raise an illegal instruction
          // exception when `vstart` is non-zero. This also governs instructions
          // from the Zvbb, Zvbc, Zvabd, Zvfbfmin, and Zvfbfwma extensions.
          "arith": true,
          // Whether the vector scalar move instructions (vmv.x.s, vmv.s.x,
          // vfmv.f.s and vfmv.s.f) raise an illegal instruction exception when
          // `vstart` is non-zero.
          "scalar_move": true
        }
      }
    },
    "B": {
      "mutable_misa": false,
      "supported": false
    },
    "S": {
      "mutable_misa": false,
      "supported": false,
      "interrupts": {
        "software": { "supported": false },
        "external": { "supported": false },
        "timer": { "supported": false }
      }
    },
    "U": {
      "mutable_misa": false,
      "supported": false
    },

    "H": {
      "mutable_misa": false,
      "supported": false,
      "geilen": 31,
      "guest_page_fault_writes_htval": true,
      // Whether a trap into M or HS mode caused by the specified exception
      // writes the transformed trapping instruction to `mtinst`/`htinst`.
      // This applies to integer and floating-point loads and stores
      // (including compressed forms), LR/SC, AMOs, HLV/HLVX/HSV and CBOs.
      // If false, zero is written instead.
      "transformed_instruction": {
        "load_access_fault": true,
        "load_address_misaligned": true,
        "load_guest_page_fault": true,
        "load_page_fault": true,
        "samo_access_fault": true,
        "samo_address_misaligned": true,
        "samo_guest_page_fault": true,
        "samo_page_fault": true
      },
      "hgatp_modes": {
        "Sv32x4": false,
        "Sv39x4": false,
        "Sv48x4": false,
        "Sv57x4": false
      },
      "vsatp_modes": {
        "Sv32": true,
        "Sv39": false,
        "Sv48": false,
        "Sv57": false
      }
    },

    "Sha": { "supported": false },
    "Shcounterenw": { "supported": false },
    "Shgatpa": { "supported": false },
    "Shtvala": { "supported": false },
    "Shvsatpa": { "supported": false },
    "Shvstvala": { "supported": false },
    "Shvstvecd": { "supported": false },
    "Sstvecd": { "supported": false },
    "Svukte": { "supported": false },
    "Zilx": { "supported": false },
    "Zibi": {
      "supported": false
    },
    "Zicbom": {
      "supported": false
    },
    "Zicbop": {
      "supported": false
    },
    "Zicboz": {
      "supported": false
    },
    // This extension just asserts that the cache block size is 64 bytes.
    // If you enable this you also need to ensure `platform.cache_block_size_exp`
    // is 6, otherwise you will get a config validation error.
    "Zic64b": {
      "supported": false
    },
    "Ziccamoa": {
      "supported": false
    },
    "Ziccamoc": {
      "supported": false
    },
    "Ziccif": {
      "supported": false
    },
    "Zicclsm": {
      "supported": false
    },
    "Ziccrse": {
      "supported": false
    },
    "Zicfilp": {
      "supported": false
    },
    "Zicfiss": {
      "supported": false
    },
    "Zicond": {
      "supported": false
    },
    // 本核心无 cycle/time/instret 计数器 CSR（周期计数为 MMIO 外设）
    "Zicntr": {
      "supported": false
    },
    // 本核心已实现 Zicsr（CSRRW/CSRRS/CSRRC 及立即数型）
    "Zicsr": {
      "supported": true
    },
    // PicoRV32 decodes MISC-MEM only with funct3 == 0 (plain FENCE); fence.i
    // (funct3 == 1) falls through to the illegal-instruction path.
    // https://github.com/YosysHQ/picorv32/blob/ef203c2b0a3fb793280f5114941416c425c5b461/picorv32.v#L1088
    "Zifencei": {
      "supported": false
    },
    "Zihintntl": {
      "supported": false
    },
    "Zihintpause": {
      "supported": false
    },
    "Zihpm": {
      "supported": false
    },
    "Zimop": {
      "supported": false
    },
    "Zmmul": {
      "supported": true    // M 已实现，Zmmul（乘法子集）随之成立
    },
    "Zaamo": {
      "supported": false
    },
    "Zabha": {
      "supported": false
    },
    "Zacas": {
      "supported": false
    },
    "Zalrsc": {
      "supported": false
    },
    "Zama16b": {
      "supported": false
    },
    "Zawrs": {
      "supported": false,
      "nto": {
        "is_nop": false
      },
      "sto": {
        "is_nop": false
      }
    },
    "Zfa": {
      "supported": false
    },
    "Zfbfmin": {
      "supported": false
    },
    "Zfh": {
